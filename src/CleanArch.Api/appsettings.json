{
  "ConnectionStrings": {
    "Ledger": "Host=localhost;Port=5432;Database=ledger;Username=ledger;Password=ledger"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "ledger",
    "Password": "ledger"
  },
  "RequestTimeouts": {
    "DefaultMilliseconds": 2000
  },
  "OpenTelemetry": {
    "ServiceName": "clean-arch-financial-api",
    "OtlpEndpoint": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
